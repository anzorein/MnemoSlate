# Copiar a .env y completar. Nunca commitear el .env real.

# --- Bot de Telegram (Fase 2) ---
BOT_TOKEN=123456:ABC-tu-token-de-BotFather
ALLOWED_USER_ID=123456789
DATABASE_PATH=data/ideas.db
LOG_LEVEL=INFO
IDEAS_PAGE_SIZE=10

# --- PC de escritorio: red y energía (Fase 1) ---
# IMPORTANTE: acá van PLACEHOLDERS, nunca valores reales. Este archivo está
# versionado; tus datos van solo en el .env local (gitignoreado) de cada máquina.
# MAC de la NIC Ethernet (NO la del WiFi USB). Windows: `getmac /v /fo list`
PC_MAC=11:22:33:44:55:66
# IP reservada en el router para la PC (misma LAN que la Raspberry).
PC_IP=192.0.2.15
# Broadcast de la subred. Vacío = se deriva de PC_IP asumiendo /24.
PC_BROADCAST=192.0.2.255
# Puertos UDP del Magic Packet (9 = discard, 7 = echo).
WOL_PORT=9
# Segundos que se espera a que la PC arranque antes de darla por perdida (RF-2.3).
WAKE_TIMEOUT=120
PING_TIMEOUT=2

# --- Apagado remoto por SSH (RF-2.4, opcional) ---
# Requiere OpenSSH Server en la PC. Vacío = el apagado remoto queda deshabilitado.
SSH_USER=
# Ruta a la clave privada en la Raspberry si no usás el agent.
SSH_KEY=
