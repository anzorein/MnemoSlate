# Copiar a .env y completar. Nunca commitear el .env real.

# --- Bot de Telegram (Fase 2) ---
BOT_TOKEN=123456:ABC-tu-token-de-BotFather
ALLOWED_USER_ID=123456789
DATABASE_PATH=data/ideas.db
LOG_LEVEL=INFO
IDEAS_PAGE_SIZE=10

# --- PC de escritorio: red y energía (Fase 1) ---
# IMPORTANTE: acá van PLACEHOLDERS, nunca valores reales. Este archivo está
# versionado; tus datos van solo en el .env local (gitignoreado) de cada máquina.
# MAC de la NIC Ethernet (NO la del WiFi USB). Windows: `getmac /v /fo list`
PC_MAC=11:22:33:44:55:66
# IP reservada en el router para la PC (misma LAN que la Raspberry).
PC_IP=192.0.2.15
# Broadcast de la subred. Vacío = se deriva de PC_IP asumiendo /24.
PC_BROADCAST=192.0.2.255
# Puertos UDP del Magic Packet (9 = discard, 7 = echo).
WOL_PORT=9
# Segundos que se espera a que la PC arranque antes de darla por perdida (RF-2.3).
WAKE_TIMEOUT=120
PING_TIMEOUT=2

# --- Apagado remoto por SSH (RF-2.4, opcional) ---
# Requiere OpenSSH Server en la PC. Vacío = el apagado remoto queda deshabilitado.
# El usuario es el de la PC, el mismo que figura en `whoami` (ej: tu cuenta de Windows).
SSH_USER=
# Ruta a la clave privada en la Raspberry. BatchMode=yes implica que NO se puede
# pedir contraseña: la autenticación por clave tiene que estar funcionando.
SSH_KEY=
# OJO (Windows): si ese usuario es ADMINISTRADOR, la clave pública va en
# C:\ProgramData\ssh\administrators_authorized_keys (NO en ~/.ssh/authorized_keys,
# que Windows ignora para admins) y con ACL de solo SYSTEM + Administradores.
# Ver la sección "Fase 1: apagado remoto por SSH" del README.

# --- Sender Fase 4 / Edessia (opcional hasta probar desde la Pi) ---
# Carpeta del libro en la PC (el --dir de `opencode run`). Sin comillas.
EDESSIA_PC_DIR=D:\Documentos\Projects\Edessia
# Modelo provider/model para `opencode run -m`. Vacío = el default de la PC.
OPENCODE_MODEL=
# Carpetas del repo de lore (checkout local en la Pi/PC). Relativas a la raíz del repo.
#   inbox/  : entrada cruda/manual (ideas para guardar, pedidos de brainstorming).
#   outputs/: salidas de OpenCode = Markdown de REFERENCIA (interim, aún no es scribe).
#   scribe/ : RESERVADO para docs ya pulidos, listos para pasar a PDF (más adelante).
INBOX_DIR=inbox
OUTPUTS_DIR=outputs
SCRIBE_DIR=scribe
# Minutos sin resultado antes de reencolar un trabajo 'enviado' (anti-zombi).
CLAIM_TIMEOUT_MIN=30
# Intentos antes de marcar un trabajo como 'error'.
MAX_INTENTOS=3
# 1 = apaga la PC solo si la encendió el ciclo. 0 = jamás apagar (e2e seguro).
APAGAR_AL_FINALIZAR=1
